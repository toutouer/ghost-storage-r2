{
  "name": "ghost-storage-r2",
  "version": "1.1.0",
  "description": "Cloudflare R2 / S3 storage adapter for Ghost 5.x & 6.x.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/toutouer/ghost-storage-r2.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "format": "prettier --write src/index.ts",
    "format:check": "prettier --check src/index.ts",
    "check": "npm run format:check && npm run typecheck && npm run build && npm test",
    "prepublishOnly": "npm run build"
  },
  "author": "toutouer",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.721.0",
    "ghost-storage-base": "^1.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/ghost-storage-base": "^0.0.4",
    "@types/node": "^22.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
